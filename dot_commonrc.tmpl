# shellcheck disable=all
# This should be safe to be sourced anywhere

{{- if eq .isWsl "yes" }}
# Note: Run these in Powershell first
# ```
# setx WINHOME $HOME
# setx WSLENV (("$env:WSLENV".TrimEnd(':') + ":WINHOME/up:").TrimStart(':'))
# ```
# Does not work in VSCode terminals
export OBSIDIAN_PATH="$WINHOME/Documents/Obsidian"
{{- end }}

# Uses fd for fzf
export FZF_DEFAULT_COMMAND="fd --type f --strip-cwd-prefix --hidden --follow --exclude .git --color always"
export FZF_DEFAULT_OPTS="--ansi"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# https://pi.dev/packages/@ff-labs/pi-fff
export PI_FFF_MODE="override"

# Copy files like cp, with rsync progress and resume
# https://wiki.archlinux.org/title/Rsync#As_cp/mv_alternative
cpr() {
    rsync --archive -hh --partial --info=stats1,progress2 --modify-window=1 "$@"
}

# ssh without host key checks (use only for throwaway hosts)
ssh-no-verify() {
    ssh -o "StrictHostKeyChecking=no" -o "UserKnownHostsFile=/dev/null" "$@"
}

# Make a directory and enter it
mkcd() {
    if [ $# -ne 1 ]; then
        echo "usage: mkcd <directory>" >&2
        return 1
    fi
    mkdir -p -- "$1" && cd -- "$1"
}

# Jump to a parent directory by name
# https://gist.github.com/GNOMES/6bf65926648e260d8023aebb9ede9573
dc() {
    # If the target is the current directory, stay here
    [ "$1" = "${PWD##*/}" ] && return 0
    cd "${PWD%/$1/*}/$1/" 2>/dev/null || echo "Directory not found: $1"
}
